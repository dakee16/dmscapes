# --- Server-side (API routes) ---
# The service-role key BYPASSES RLS. Server only; never NEXT_PUBLIC_, never
# imported outside lib/supabase-server.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Client-side auth ---
# The anon (publishable) key is safe in the browser bundle; RLS is the gate.
# Same project URL as above, e.g. https://<project-ref>.supabase.co.
#
# This is the single source of truth for the Supabase host: it drives the
# browser client (lib/supabase-browser.ts) and the CSP connect-src origin
# (next.config.ts), so nothing about the host is hardcoded. Once the branded
# custom auth domain is live, set this to https://auth.dormscape.us to route
# auth + OAuth through your own domain instead of the raw *.supabase.co URL.
# See docs/auth-email-deliverability.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in is configured in the Supabase dashboard
# (Authentication → Providers → Google), NOT via env vars in this app.
# See the auth setup notes in the repo/PR description.

# --- Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Transactional email: Contact Us form (optional but recommended) ---
# Powers the notification email sent when someone uses /contact. Without a key,
# the message is still logged to the contact_submissions table (durable record);
# it just isn't emailed. Uses Resend (https://resend.com) via its REST API.
#   1. Create a Resend account and verify the dormscape.us domain (add the DNS
#      records it gives you). Until verified, send from onboarding@resend.dev.
#   2. Paste the API key below.
RESEND_API_KEY=
# Optional overrides (sensible defaults are used if unset):
# CONTACT_FROM_EMAIL="Dormscape <contact@dormscape.us>"   # must be on a verified domain
# CONTACT_TO_EMAIL=info@dormscape.us                       # where messages are delivered

# --- Dormscape Plus payments: Stripe one-time checkout ($4.99) ---
# Without these, the Plus upgrade button shows a friendly "not set up yet"
# message and nothing is charged; free/plus gating still works (defaults free).
#   1. Create a Stripe account (https://stripe.com). Use TEST keys while building.
#   2. Secret key (Developers -> API keys). Server-only; never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
#   3. Webhook signing secret. Create an endpoint at
#      https://dashboard.stripe.com/webhooks pointing to
#      https://YOUR_DOMAIN/api/stripe/webhook, subscribe to the event
#      "checkout.session.completed", then paste its signing secret (whsec_...).
#      For local testing: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
#   4. Optional: a pre-made Price ID (one-time, $4.99). If unset, the checkout
#      route builds the $4.99 line item inline, so this is not required.
# STRIPE_PLUS_PRICE_ID=price_xxx

# --- Misc (optional) ---
# Canonical origin used by sitemap.xml AND Stripe success/cancel redirects.
# Set this in production so checkout returns to the right place.
# NEXT_PUBLIC_SITE_URL=https://dormscape.us
